# Copy to .panel.env on the instance.
# Domain for the panel (an A record pointing to the instance's Elastic IP).
PANEL_DOMAIN=db.example.com

# Who can log in, comma separated.
ALLOWED_EMAILS=me@example.com

# Brevo (transactional email API key) and a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=just-a-db

# Host shown in the connection URLs of new databases (domain or Elastic IP).
PUBLIC_DB_HOST=db.example.com
TZ=America/Bogota

# Local only: print login codes in the panel's logs instead of emailing them.
# DEV_LOG_CODES=true
